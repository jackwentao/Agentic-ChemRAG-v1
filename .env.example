APP_NAME=Agentic-ChemRAG
ENV=dev
API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=postgresql+psycopg://chemrag:chemrag@localhost:5432/chemrag
REDIS_URL=redis://localhost:6380/0
UPLOAD_DIR=storage/uploads
IMAGE_DIR=storage/images
MODEL_CACHE_DIR=storage/models
ROUTER_CACHE_DIR=storage/router_cache
ROUTER_CACHE_ENABLED=true
ROUTER_WARMUP_ON_STARTUP=true
EVALUATION_WARMUP=true
OBJECT_STORAGE_PROVIDER=minio
MINIO_ENDPOINT=localhost:9100
MINIO_ACCESS_KEY=chemrag
MINIO_SECRET_KEY=chemrag-secret
MINIO_BUCKET=chemrag
MINIO_SECURE=false

DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=25
LLM_IMAGE_SELECTION_ENABLED=false

EMBEDDING_PROVIDER=local_bge_m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_LOCAL_FILES_ONLY=false

RERANKER_ENABLED=true
RERANKER_PROVIDER=local_bge
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_LOCAL_FILES_ONLY=false
RERANKER_CHUNK_CANDIDATES=30
RERANKER_FIGURE_CANDIDATES=32
RERANKER_WARMUP_ON_STARTUP=true
